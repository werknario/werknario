# --- LLM proxy (packages/proxy) ---
# The proxy is the only component that holds model credentials. The extension
# never sees these. See ADMIN notes in the werknario repo for how to obtain them.

# Which provider the proxy uses: "mock" | "anthropic" | "bedrock"
# mock  = deterministic scripted responses, for tests and offline dev (no creds)
# bedrock = Anthropic via AWS Bedrock, EU inference profile (the werknario default)
# anthropic = Anthropic API directly (only if explicitly allowed for a given env)
LLM_PROVIDER=mock

# Model id the proxy asks the provider for.
# For bedrock EU use the EU inference profile id, e.g.
#   eu.anthropic.claude-sonnet-4-...  (fill from the account's Bedrock console)
LLM_MODEL=PLEASE_INSERT_HERE

# Shared bearer token the extension must present to the proxy (Authorization: Bearer ...).
# Generate a long random value. This is NOT a GitLab or AWS credential.
PROXY_BEARER_TOKEN=PLEASE_INSERT_HERE

# Port the proxy listens on (9100-9199 range to avoid local clashes).
PROXY_PORT=9109

# CORS: comma-separated allowed origins, or "*" (safe here because auth is a
# bearer token, not cookies — see werknario docs/spikes Spike B).
PROXY_ALLOWED_ORIGINS=*

# --- provider: bedrock (LLM_PROVIDER=bedrock) ---
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=PLEASE_INSERT_HERE
AWS_SECRET_ACCESS_KEY=PLEASE_INSERT_HERE
# optional if using temporary creds
AWS_SESSION_TOKEN=

# --- provider: anthropic (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=PLEASE_INSERT_HERE
# The CLI also accepts CLAUDE_API_TOKEN for the anthropic provider.
# CLAUDE_API_TOKEN=PLEASE_INSERT_HERE

# --- provider: openai-compatible (LLM_PROVIDER=openai-compatible) ---
# One provider for Mistral (EU-native), a self-hosted vLLM endpoint, or Kimi /
# DeepSeek / Qwen. For personal data, use an EU host or self-hosting (see docs).
# LLM_OPENAI_COMPAT_BASE_URL=https://api.mistral.ai/v1
# LLM_OPENAI_COMPAT_API_KEY=PLEASE_INSERT_HERE

# --- CLI backend: where your documents live (packages/cli) ---
# One of: gitlab | github | mock. Omit to auto-detect (github if GITHUB_REPO is
# set, else gitlab). "mock" is an in-memory repo for the offline demo.
WERKNARIO_BACKEND=mock

# GitLab (token needs the "api" scope)
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_PROJECT_ID=12345
# GITLAB_TOKEN=PLEASE_INSERT_HERE

# GitHub (token needs repo contents + pull-requests write)
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=PLEASE_INSERT_HERE
# GITHUB_API_URL=https://api.github.com

# --- CLI identity and behaviour ---
# WERKNARIO_AGENT_ID=agent:assistant     # shows up in the audit log
# WERKNARIO_HUMAN=human:you
# WERKNARIO_AUTO_APPROVE=1               # approve everything (unattended); = --yes
# WERKNARIO_ROUTE=1                      # router picks a cheaper model for easy steps
# WERKNARIO_BUDGET_USD=5                 # stop the run when it costs this much
# WERKNARIO_LOCALE=de                    # German prompts and messages
# WERKNARIO_AUDIT=.werknario/audit.jsonl
# WERKNARIO_POLICY=.werknario/policy.json
