node_modules/
dist/
out/
*.vsix
coverage/
.vscode-test-web/
.DS_Store

# secrets — never commit
.env
.env.local

# registry build artifact (produced by build-ext-store.sh / Docker build)
registry/ext-store/

# but DO keep the hermetic test fixtures, even though *.vsix / dist/ are ignored
# globally — the registry tests read them, and CI clones only what's committed
!registry/test/fixtures/store/**/*.vsix
!registry/test/fixtures/store/**/dist/
!registry/test/fixtures/store/**/dist/**

# local test infra artifacts
infra/local-gitlab/.boot-status
infra/local-gitlab/boot.log
infra/local-gitlab/.local-admin-token

# logs
*.log

# runtime data: the agent's audit log and the docker-compose work volume
.werknario/audit.jsonl
work/
# keep the example policy checked in
!.werknario/policy.example.json
